<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.mainframe</groupId>
        <artifactId>mainframe</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>mainframe-core</artifactId>

    <name>mainframe-core</name>
    <description>
        The controller: the frame, which decides, its jobs, and the shell each tab runs. Reached only by messages.
    </description>

    <!--
      What the controller may build against, and what it may not. It may use the framework's vocabulary, the bus, and
      vexelray-gui-core's values (a span, a colour, the settings store), all of which are safe from any thread. It may
      not use a widget, the window or the shell: those are -gui's, and a widget here would put the view back inside
      the controller. Nothing enforces that but this list, so a dependency added here is a decision about where the
      line is.
    -->
    <dependencies>
        <!-- @Component, @Job, @Subscribe, @Publishes, @Configuration: checked by the processor while this compiles. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-api</artifactId>
            <version>${vexelray-framework.version}</version>
        </dependency>
        <!-- The command line's paths (Launch), which the editor opens once the window exists. JDK-only. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-core</artifactId>
            <version>${vexelray-framework.version}</version>
        </dependency>
        <!-- Span, Color and Settings, and through it the bus (atchung-core) and the logger (atchung-probe). -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-core</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>

        <!-- The pseudo-terminal a tab's Shell opens: JDK-only, no widget. The platform's own (ConPTY, posix_openpt) is
             found by ServiceLoader, so -gui takes it at run time and the tests below take it here. -->
        <dependency>
            <groupId>dev.sibarum</groupId>
            <artifactId>vex-suite-common-pty</artifactId>
            <version>${vex-suite-common.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.sibarum</groupId>
                    <artifactId>vex-suite-common-pty-windows</artifactId>
                    <version>${vex-suite-common.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.sibarum</groupId>
                    <artifactId>vex-suite-common-pty-linux</artifactId>
                    <version>${vex-suite-common.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
