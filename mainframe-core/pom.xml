<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.mainframe</groupId>
        <artifactId>mainframe</artifactId>
        <version>0.1.3-SNAPSHOT</version>
    </parent>

    <artifactId>mainframe-core</artifactId>

    <name>mainframe-core</name>
    <description>
        The controller: the Frame, which decides, and the jobs that touch the disk and start processes. Reached only by
        messages.
    </description>

    <!--
      What the controller may build against, and what it may not. It may use the framework's vocabulary, the bus,
      vexelray-gui-core's values (the settings store), all of which are safe from any thread, and the pty library's
      platform facts (which shells there are, a file's short name), which are JDK-only. It may not use a widget, the
      window, the shell or a terminal's screen: those are -gui's, and a widget here would put the view back inside the
      controller. Nothing enforces that but this list, so a dependency added here is a decision about where the line is.
    -->
    <dependencies>
        <!-- @Component, @Job, @Subscribe, @Publishes, @Configuration: checked by the processor while this compiles. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-api</artifactId>
            <version>${vexelray-framework.version}</version>
        </dependency>
        <!-- Settings, and through it the bus (atchung-core) and the logger (atchung-probe). -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-core</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- The shells this machine has, and a file's short name: the pty library's platform facts. JDK-only; the
             pseudoconsole itself is started by -gui, beside the screen it feeds. -->
        <dependency>
            <groupId>dev.sibarum</groupId>
            <artifactId>vex-suite-common-pty</artifactId>
            <version>${vex-suite-common.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!-- The pty's OS module, for this module's tests: which shells there are is the platform's to say. -->
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.sibarum</groupId>
                    <artifactId>vex-suite-common-pty-windows</artifactId>
                    <version>${vex-suite-common.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.sibarum</groupId>
                    <artifactId>vex-suite-common-pty-linux</artifactId>
                    <version>${vex-suite-common.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
