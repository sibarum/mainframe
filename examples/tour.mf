# A tour of MainFrame. Run it with:  mainframe examples/tour.mf
# Nothing here changes a file for good; the parts that would are shown with --dry-run.

echo "1. values keep their types"
ls | first 3 | select name size mime

echo "2. filtering talks about columns, not text"
ls --recurse --max-depth=2
  | where kind == "file" and size > 1kb
  | sort-by size --reverse
  | first 5
  | select name size

echo "3. media types come from the bytes, not the file name"
ls | where kind == "file" | mime | select name mime detected-by misleading-name

echo "4. what is in here, by extension"
ls --recurse | where kind == "file" | count-by ext | first 8

echo "5. how much of it there is"
ls --recurse | where kind == "file" | sum size

echo "6. sizes and maths"
let budget = 10mb
echo ($budget - (ls --recurse | where kind == "file" | sum size))

echo "7. moments and spans are values, so they can be compared and subtracted"
ls | where modified > (now - 7d) | length
echo (now - 2026-01-01)

echo "8. anything destructive tells you first"
ls | where kind == "file" | first 1 | rm --dry-run

echo "9. the environment can change between commands, with no restart"
env-set TOUR_VAR "set while running"
env TOUR_VAR

echo "10. a value written to a file reads back as itself"
ls | where kind == "file" | select name size modified | save ./tour-listing.csv --force
open ./tour-listing.csv | sum size
ls | where kind == "file" | sum size
rm ./tour-listing.csv --yes
