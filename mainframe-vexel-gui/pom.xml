<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.mainframe</groupId>
    <artifactId>mainframe-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>mainframe-vexel-gui</artifactId>
  <packaging>jar</packaging>

  <name>MainFrame on vexelray-gui</name>
  <description>
    MainFrame as a window: the console an application embeds, the seams it plugs its own commands and screens
    into, and a main() that boots MainFrame on its own with nothing hosting it.
  </description>

  <properties>
    <!-- mvn -pl mainframe-vexel-gui compile exec:exec  ->  MainFrame in a window, hosted by nobody. -->
    <app.mainClass>dev.mainframe.gui.desktop.Desktop</app.mainClass>
    <!-- One token each, because a Maven property is not a command line. Blank slots are dropped. -->
    <app.args></app.args>
    <app.args2></app.args2>
  </properties>

  <dependencies>
    <!-- The shell itself. Everything in this module is a face for it. -->
    <dependency>
      <groupId>dev.mainframe</groupId>
      <artifactId>mainframe-core</artifactId>
    </dependency>

    <!-- The widgets the console is built out of: TextField for the command line, TitleBar for the chrome.
         Brings gui-core, and through it atchung, tactroller-api, canvas, text and os-api. -->
    <dependency>
      <groupId>dev.vexelray.gui</groupId>
      <artifactId>vexelray-gui-widget</artifactId>
      <version>${vexelray-gui.version}</version>
    </dependency>

    <!-- The native file dialog, and the only native binding in here. It is what lets this editor claim `pick`
         in the panel protocol: a form asking for a path gets the OS chooser, with its shortcuts, its network
         places and the folder somebody was last in, which is not a thing worth reimplementing on a tube.
         Windows and macOS only: see NativeChooser, which asks before claiming, and MainFrame draws its own
         chooser everywhere else. -->
    <dependency>
      <groupId>dev.vexelray.gui</groupId>
      <artifactId>vexelray-gui-nfd</artifactId>
      <version>${vexelray-gui.version}</version>
    </dependency>

    <!-- Input and clipboard, for the standalone boot only. An application that hosts the console already owns
         both and wires them itself (Console.gui() is public for exactly that); Desktop is the case where there
         is no application, so the module has to be able to open them. -->
    <dependency>
      <groupId>sibarum.tactroller</groupId>
      <artifactId>tactroller-atchung</artifactId>
      <version>${tactroller.version}</version>
    </dependency>
    <dependency>
      <groupId>sibarum.tactroller</groupId>
      <artifactId>tactroller-clipboard</artifactId>
      <version>${tactroller.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Constructing a Console asks whether this machine has a native file dialog, which loads the NFD
               library. Without this the JDK warns about the restricted call on every test run. -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <executable>${java.home}/bin/java</executable>
          <classpathScope>runtime</classpathScope>
          <arguments>
            <argument>--enable-native-access=ALL-UNNAMED</argument>
            <argument>-classpath</argument>
            <classpath/>
            <argument>${app.mainClass}</argument>
            <argument>${app.args}</argument>
            <argument>${app.args2}</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Build-time platform selection: the native backends the standalone boot needs at runtime. Same shape as
         every other client of this stack, and runtime-scoped so nothing here compiles against a platform. -->
    <profile>
      <id>platform-windows</id>
      <activation><os><family>windows</family></os></activation>
      <dependencies>
        <dependency>
          <groupId>dev.vexelray</groupId>
          <artifactId>vexelray-os-windows</artifactId>
          <version>${vexelray.version}</version>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>sibarum.tactroller</groupId>
          <artifactId>tactroller-windows</artifactId>
          <version>${tactroller.version}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>platform-linux</id>
      <activation><os><family>unix</family><name>linux</name></os></activation>
      <dependencies>
        <dependency>
          <groupId>dev.vexelray</groupId>
          <artifactId>vexelray-os-linux</artifactId>
          <version>${vexelray.version}</version>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>sibarum.tactroller</groupId>
          <artifactId>tactroller-linux</artifactId>
          <version>${tactroller.version}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>platform-macos</id>
      <activation><os><family>mac</family></os></activation>
      <dependencies>
        <dependency>
          <groupId>dev.vexelray</groupId>
          <artifactId>vexelray-os-macos</artifactId>
          <version>${vexelray.version}</version>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>sibarum.tactroller</groupId>
          <artifactId>tactroller-macos</artifactId>
          <version>${tactroller.version}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
