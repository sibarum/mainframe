<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.mainframe</groupId>
  <artifactId>mainframe</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>MainFrame</name>
  <description>A terminal window that wraps the native OS shell. v1: Windows PowerShell over ConPTY.</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <!-- The stack the window sits on. Local installs; see vexelray-gui/CLAUDE.md for the build order. -->
    <vexelray-gui.version>0.1.0-SNAPSHOT</vexelray-gui.version>
    <vexelray.version>0.1.0-SNAPSHOT</vexelray.version>
    <tactroller.version>1.0-SNAPSHOT</tactroller.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.vexelray.gui</groupId>
      <artifactId>vexelray-gui-widget</artifactId>
      <version>${vexelray-gui.version}</version>
    </dependency>
    <!-- The clock: tab changes are animated, and motion enters at the application edge. -->
    <dependency>
      <groupId>dev.vexelray.gui</groupId>
      <artifactId>vexelray-gui-krono</artifactId>
      <version>${vexelray-gui.version}</version>
    </dependency>
    <dependency>
      <groupId>sibarum.tactroller</groupId>
      <artifactId>tactroller-atchung</artifactId>
      <version>${tactroller.version}</version>
    </dependency>
    <dependency>
      <groupId>sibarum.tactroller</groupId>
      <artifactId>tactroller-clipboard</artifactId>
      <version>${tactroller.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <executable>${java.home}/bin/java</executable>
          <classpathScope>runtime</classpathScope>
          <arguments>
            <argument>--enable-native-access=ALL-UNNAMED</argument>
            <argument>-classpath</argument>
            <classpath/>
            <argument>dev.mainframe.Main</argument>
          </arguments>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>dev.mainframe.Main</mainClass>
            </manifest>
            <manifestEntries>
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- v1 is Windows-only: ConPty is the one piece that is. Linux/macOS would add a pty sibling and their own profiles here. -->
    <profile>
      <id>platform-windows</id>
      <activation><os><family>windows</family></os></activation>
      <dependencies>
        <dependency>
          <groupId>dev.vexelray</groupId>
          <artifactId>vexelray-os-windows</artifactId>
          <version>${vexelray.version}</version>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>sibarum.tactroller</groupId>
          <artifactId>tactroller-windows</artifactId>
          <version>${tactroller.version}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>

