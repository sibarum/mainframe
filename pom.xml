<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.mainframe</groupId>
  <artifactId>mainframe</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>MainFrame</name>
  <description>A terminal window that wraps the native OS shell. v1: Windows PowerShell over ConPTY.</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <!-- The stack the window sits on. Local installs; see vexelray-gui/CLAUDE.md for the build order. -->
    <vexelray-gui.version>0.1.0-SNAPSHOT</vexelray-gui.version>
    <vexelray.version>0.1.0-SNAPSHOT</vexelray.version>
    <tactroller.version>1.0-SNAPSHOT</tactroller.version>
    <!-- The automation socket ottermate drives: "off", "on" for the default port, or a port number; 0 is a free one. -->
    <automation>off</automation>
    <!--
      Two editions of the same code. The debug edition links the automation socket; the release edition does not
      contain it at all: -Pnative-release swaps the source root below for src/edition-release (a Driving that does
      nothing) and drops the automation dependency from every classpath. Default (JVM, tests, exec:exec) = debug.
    -->
    <edition.src>src/edition-debug/java</edition.src>
    <automation.scope>compile</automation.scope>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.vexelray.gui</groupId>
      <artifactId>vexelray-gui-widget</artifactId>
      <version>${vexelray-gui.version}</version>
    </dependency>
    <!-- The clock: tab changes are animated, and motion enters at the application edge. -->
    <dependency>
      <groupId>dev.vexelray.gui</groupId>
      <artifactId>vexelray-gui-krono</artifactId>
      <version>${vexelray-gui.version}</version>
    </dependency>
    <!-- The title bar's screenshot button that asks where to save, as the framework's applications have. -->
    <dependency>
      <groupId>dev.vexelray.gui</groupId>
      <artifactId>vexelray-gui-nfd</artifactId>
      <version>${vexelray-gui.version}</version>
    </dependency>
    <!-- The driving socket, off unless asked for. -->
    <dependency>
      <groupId>dev.vexelray.gui</groupId>
      <artifactId>vexelray-gui-automation</artifactId>
      <version>${vexelray-gui.version}</version>
      <scope>${automation.scope}</scope>
    </dependency>
    <dependency>
      <groupId>sibarum.tactroller</groupId>
      <artifactId>tactroller-atchung</artifactId>
      <version>${tactroller.version}</version>
    </dependency>
    <dependency>
      <groupId>sibarum.tactroller</groupId>
      <artifactId>tactroller-clipboard</artifactId>
      <version>${tactroller.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The mark, on the class path for the title bar: the same file src/main/rc/mainframe.rc links into the
           executable, so the two are one file and cannot drift. -->
      <resource>
        <directory>src/main/rc</directory>
        <includes>
          <include>mainframe.ico</include>
        </includes>
      </resource>
    </resources>
    <pluginManagement>
      <plugins>
        <!-- The executable's icon: a resource linked into the program, so it has to exist as a compiled .res before
             link time. rc.exe is the Windows SDK's resource compiler and must be on PATH, as it is in a Visual
             Studio developer prompt (which the native build already needs for link.exe). -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.1.0</version>
          <executions>
            <execution>
              <id>compile-icon-resource</id>
              <phase>prepare-package</phase>
              <goals><goal>run</goal></goals>
              <configuration>
                <target>
                  <exec executable="rc.exe" searchpath="true" failonerror="true">
                    <arg value="/nologo"/>
                    <arg value="/fo"/>
                    <arg file="${project.build.directory}/mainframe.res"/>
                    <arg file="${project.basedir}/src/main/rc/mainframe.rc"/>
                  </exec>
                </target>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.graalvm.buildtools</groupId>
          <artifactId>native-maven-plugin</artifactId>
          <version>0.10.6</version>
          <executions>
            <execution>
              <id>build-native</id>
              <goals><goal>compile-no-fork</goal></goals>
              <phase>package</phase>
            </execution>
          </executions>
          <configuration>
            <imageName>${native.imageName}</imageName>
            <mainClass>dev.mainframe.Main</mainClass>
            <buildArgs>
              <!-- The FFM flags, the shaders and the font atlas come from the libraries' own
                   META-INF/native-image metadata; only what is this program's is set here. -->
              <buildArg>--no-fallback</buildArg>
              <!-- WINDOWS needs /ENTRY:mainCRTStartup as well: the linker would otherwise look for WinMain,
                   and the image's entry is the C main. CONSOLE is the linker's default, spelled out so both
                   editions pass the same two options. -->
              <buildArg>-H:NativeLinkerOption=/SUBSYSTEM:${native.subsystem}</buildArg>
              <buildArg>-H:NativeLinkerOption=/ENTRY:mainCRTStartup</buildArg>
              <buildArg>-H:NativeLinkerOption=${project.build.directory}/mainframe.res</buildArg>
            </buildArgs>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- The edition's own sources (Driving): src/edition-debug, or src/edition-release under -Pnative-release. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-edition-source</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>${edition.src}</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <executable>${java.home}/bin/java</executable>
          <classpathScope>runtime</classpathScope>
          <arguments>
            <argument>--enable-native-access=ALL-UNNAMED</argument>
            <argument>-Dautomation=${automation}</argument>
            <argument>-classpath</argument>
            <classpath/>
            <argument>dev.mainframe.Main</argument>
          </arguments>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>dev.mainframe.Main</mainClass>
            </manifest>
            <manifestEntries>
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      GraalVM native images; both need a GraalVM JDK (JAVA_HOME) and are profile-gated because native-image takes
      minutes. Each library jar carries its own reachability metadata (META-INF/native-image/); mainframe's, under
      src/main/resources, lists only Main and ConPty's calls into kernel32.

        mvn -Pnative-release package -DskipTests  ->  target/mainframe.exe        what ships and gets signed
        mvn -Pnative package -DskipTests          ->  target/mainframe-debug.exe  for ottermate

      release: Windows GUI subsystem (no console window ever) and no automation socket in the image.
      debug:   console subsystem (stdout is the `automation: localhost:<port>` protocol line) and automation.
      The plugins are declared once, in pluginManagement above; the profiles only choose their inputs. Both run
      rc.exe for the icon (src/main/rc), so run them from a Visual Studio developer prompt.
    -->
    <profile>
      <id>native</id>
      <properties>
        <native.imageName>mainframe-debug</native.imageName>
        <native.subsystem>CONSOLE</native.subsystem>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <extensions>true</extensions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>native-release</id>
      <properties>
        <native.imageName>mainframe</native.imageName>
        <native.subsystem>WINDOWS</native.subsystem>
        <edition.src>src/edition-release/java</edition.src>
        <automation.scope>test</automation.scope>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <extensions>true</extensions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- v1 is Windows-only: ConPty is the one piece that is. Linux/macOS would add a pty sibling and their own profiles here. -->
    <profile>
      <id>platform-windows</id>
      <activation><os><family>windows</family></os></activation>
      <dependencies>
        <dependency>
          <groupId>dev.vexelray</groupId>
          <artifactId>vexelray-os-windows</artifactId>
          <version>${vexelray.version}</version>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>sibarum.tactroller</groupId>
          <artifactId>tactroller-windows</artifactId>
          <version>${tactroller.version}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>

