{
  "id": "mainframe",
  "name": "MainFrame",
  "publisher": "sibarum",
  "description": "A terminal window that wraps the native Windows shell over ConPTY, built on the VexelRay stack.",
  "version": "0.1.2-SNAPSHOT",

  "repo": "sibarum/vexelray-dist",
  "branch": "main",
  "repoPath": "apps/mainframe",
  "releasesRepo": "sibarum/vexelray-dist",
  "tagFormat": "mainframe-v{version}",

  "windows": {
    "binaries": [
      {
        "name": "mainframe",
        "source": "mainframe-gui/target/mainframe.exe",
        "icon": "mainframe-gui/src/main/rc/mainframe.ico",
        "addToPath": true,
        "shortcuts": { "desktop": true, "startMenu": true, "label": "MainFrame" }
      },
      {
        "name": "mainframe-ffmpeg-record",
        "source": "mainframe-gui/target/mainframe-ffmpeg-record-windows-x86_64.zip",
        "dir": "ffmpeg-record"
      },
      { "name": "notices", "source": "THIRD-PARTY-NOTICES.txt" }
    ]
  },

  "linux": {
    "binaries": [
      {
        "name": "mainframe",
        "appId": "dev.mainframe.mainframe",
        "source": "mainframe-gui/target-linux/mainframe",
        "icon": "mainframe-gui/src/main/rc/mainframe.ico",
        "addToPath": true,
        "shortcuts": { "desktop": true, "startMenu": true, "label": "MainFrame" }
      },
      {
        "name": "mainframe-ffmpeg-record",
        "source": "mainframe-gui/target-linux/mainframe-ffmpeg-record-linux-x86_64.tar.gz",
        "dir": "ffmpeg-record"
      },
      { "name": "notices", "source": "THIRD-PARTY-NOTICES.txt" }
    ]
  }
}
